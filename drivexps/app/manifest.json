{
  "name": "DriveXPS - Rotas Shopee",
  "short_name": "DriveXPS",
  "description": "Roteirizador de alta precisão e organizador de carga para entregadores",
  "start_url": "https://studiotesta.com.br/drivexps/app/",
  "scope": "https://studiotesta.com.br/drivexps/app/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#060913",
  "theme_color": "#ea580c",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "https://studiotesta.com.br/drivexps/app/",
      "name": "Romaneio de Entrega",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192"
        }
      ],
      "accept": {
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
        "application/vnd.ms-excel": [".xls"],
        "text/csv": [".csv"],
        "text/plain": [".txt"]
      }
    }
  ],
  "share_target": {
    "action": "./compartilhar-arquivo",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "romaneio",
          "accept": [
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            ".xlsx",
            "application/vnd.ms-excel",
            ".xls",
            "text/csv",
            ".csv"
          ]
        }
      ]
    }
  }
}